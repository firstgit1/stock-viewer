# 会话签名（必填）
AUTH_SECRET=请改成一串足够长的随机字符串

# 管理员账号（环境变量配置，不会进 Redis；用户名不可被注册占用）
AUTH_USER=admin
AUTH_PASS=请改成管理员密码

# 生产环境必填：Upstash Redis（https://console.upstash.com/）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选：PushPlus Token（也可在管理后台填写，优先用后台配置）
# PUSHPLUS_TOKEN=

# 可选：保护定时推送接口（外部 cron / Vercel Cron 请求头 Authorization: Bearer xxx）
# CRON_SECRET=请改成随机字符串

# 说明：本地开发若不配 Upstash，会自动用 .data 目录存数据
